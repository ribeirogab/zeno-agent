# Obsidian workspace (machine-local)
context/.obsidian/workspace.json
context/.obsidian/workspace-mobile.json
context/.obsidian/cache
context/.obsidian/plugins/*/data.json

# OS
.DS_Store

# User profile (personal to whoever runs this Zeno instance)
profile/USER.md

# Skills — all gitignored by default (user-specific context)
# Only Zeno's own skills are committed via exceptions
profile/skills/*
!profile/skills/dev-workflow/

# Node
node_modules/
dist/

# Secrets
.env
.env.local

# Logs
*.log

