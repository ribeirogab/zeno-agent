{
  "name": "@zeno/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4242",
    "build": "next build",
    "start": "next start -p 4242",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .next .source .open-next .wrangler src/generated content/docs/connector-catalogue.mdx",
    "docs:generate": "tsx scripts/generate-connector-catalogue.ts && tsx scripts/generate-cli-flag-tables.ts",
    "postinstall": "pnpm run docs:generate && fumadocs-mdx",
    "predev": "pnpm run docs:generate && fumadocs-mdx",
    "prebuild": "pnpm run docs:generate && fumadocs-mdx",
    "cf:build": "pnpm run docs:generate && fumadocs-mdx && opennextjs-cloudflare build",
    "preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@zeno/ui": "workspace:*",
    "fumadocs-core": "^16.8.8",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-ui": "^16.8.8",
    "lucide-react": "^0.460.0",
    "next": "^16.2.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.90.0"
  }
}
