{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*.ts", "source.config.ts"],
  "exclude": ["node_modules", ".next"]
}
