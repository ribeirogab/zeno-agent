// Cloudflare Worker config for the @zeno/docs site.
//
// Deployed via @opennextjs/cloudflare:
//   pnpm --filter @zeno/docs deploy
//
// `account_id` is committed on purpose — Cloudflare account IDs are not
// secrets (they're visible in any worker URL anyone can hit). Do NOT move
// it to a repo secret.
//
// One-time R2 bucket creation (required before first deploy with R2 binding):
//   wrangler r2 bucket create zeno-docs-isr-cache
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeno-docs",
  "main": ".open-next/worker.js",
  "account_id": "9890bc74ec17df307df583147a6ea97f",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domain. The zone (zeno-agent.dev) lives in the same Cloudflare
  // account; `custom_domain: true` makes Cloudflare auto-provision DNS +
  // TLS cert when the Worker is published. The docs are pinned to the
  // `docs.` subdomain so the apex is free for `apps/web` (the landing).
  "routes": [{ "pattern": "docs.zeno-agent.dev", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // R2 incremental cache for OpenNext-Cloudflare. The binding name is fixed
  // by the package convention; see open-next.config.ts.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "zeno-docs-isr-cache"
    }
  ]
}
