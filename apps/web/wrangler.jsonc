// Cloudflare Worker config for the @zeno/web landing page.
//
// Deployed via `wrangler deploy` against the static `dist/` produced by
// Vite. There is no Worker `main` — Cloudflare auto-injects an asset-only
// Worker around the `assets` binding. SPA fallback returns `index.html`
// for any unmatched path so the landing always renders something.
//
//   pnpm --filter @zeno/web deploy
//
// `account_id` is committed on purpose — Cloudflare account IDs are not
// secrets (they're visible in any Worker URL anyone can hit). Do NOT move
// it to a repo secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeno-web",
  "account_id": "9890bc74ec17df307df583147a6ea97f",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  // Custom domain. The zone (zeno-agent.dev) lives in the same Cloudflare
  // account; `custom_domain: true` makes Cloudflare auto-provision DNS +
  // TLS cert when the Worker is published. Apex + www both serve the same
  // landing; `https://zeno-agent.dev/` is the canonical (matches the SEO
  // meta in apps/web/index.html).
  "routes": [
    { "pattern": "zeno-agent.dev", "custom_domain": true },
    { "pattern": "www.zeno-agent.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
