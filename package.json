{
  "name": "zeno-agent",
  "version": "2026.5.19",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "quality-gate": "turbo run lint typecheck test --concurrency=10",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "design:lint": "design.md lint DESIGN.md",
    "design:diff": "design.md diff",
    "design:export-tailwind": "design.md export --format tailwind DESIGN.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@google/design.md": "0.1.1",
    "concurrently": "^9.2.1",
    "knip": "^6.4.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ]
  }
}
