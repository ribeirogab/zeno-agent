# Spec 0071: encryption key for all credentials stored in the DB
# (backend_credentials + connector_secrets). 32 bytes, hex-encoded
# (64 hex chars). Generate with:
#   openssl rand -hex 32
# CRITICAL: BACKUP THIS KEY OFFLINE. Losing it makes every encrypted
# credential (Slack tokens, GitHub PATs via connectors, Claude OAuth
# token) unrecoverable. Anyone with the key + the DB file can decrypt.
ZENO_MASTER_KEY=REPLACE_ME

# Runtime
LOG_LEVEL=info
WORKSPACE_DIR=/workspace
LOGS_RETENTION_DAYS=7

# Dashboard auth
DASHBOARD_PASSWORD=changeme-please
DASHBOARD_SESSION_SECRET=generate-me-with-openssl-rand-hex-32
