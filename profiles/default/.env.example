# Slack — historical, ignored after spec 0058 (channel creds live in DB).
# Kept here only for old `.env` files; safe to leave blank.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# GitHub — required for the worker's `gh` CLI health check.
GH_TOKEN=ghp_REPLACE_ME

# Spec 0071: encryption key for credentials in the DB.
# 32 bytes, hex-encoded (64 hex chars). Generate with:
#   openssl rand -hex 32
# CRITICAL: BACKUP THIS KEY OFFLINE. Losing it makes every encrypted
# credential (Slack tokens, GitHub PAT via connectors, Claude OAuth
# token) unrecoverable. Anyone with the key + the DB file can decrypt.
ZENO_MASTER_KEY=REPLACE_ME

# Spec 0071: legacy CLAUDE_CODE_OAUTH_TOKEN — set this ONLY when
# importing from a pre-0071 setup. Worker reads it once at boot, writes
# the encrypted value to backend_credentials, then ignores the env on
# every subsequent boot. New installs leave this blank and use the
# dashboard onboarding (http://localhost:3000) to connect Claude.
# CLAUDE_CODE_OAUTH_TOKEN=

# Runtime
LOG_LEVEL=info
WORKSPACE_DIR=/workspace

# Dashboard auth
DASHBOARD_PASSWORD=changeme-please
DASHBOARD_SESSION_SECRET=generate-me-with-openssl-rand-hex-32
