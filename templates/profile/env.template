# managed by zeno CLI — manual edits to ZENO_MASTER_KEY will be overwritten on next start

# Encryption key for credentials stored in the runtime DB (zeno.db).
# 32 bytes, hex-encoded (64 hex chars). Generated by `zeno profile create`.
# CRITICAL: backup ~/.zeno/state.db (which holds the canonical key) offline.
# Losing it makes every encrypted credential (Slack tokens, GitHub PATs via
# connectors, Claude OAuth token) unrecoverable.
ZENO_MASTER_KEY=<generated>

# Runtime
LOG_LEVEL=info
WORKSPACE_DIR=/workspace
LOGS_RETENTION_DAYS=7

# Dashboard auth (operator must set; runtime refuses to boot otherwise)
DASHBOARD_PASSWORD=changeme-please
DASHBOARD_SESSION_SECRET=generate-me-with-openssl-rand-hex-32
